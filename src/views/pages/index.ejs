<section class="hero-banner d-flex align-items-center justify-content-center text-center text-white position-relative">
    <div class="container py-5">
        <h1 class="display-4 fw-bold mb-3">Séjournez au cœur des Alpes</h1>
        <p class="lead mb-4 mx-auto" style="max-width: 600px;">Découvrez notre sélection exclusive de chalets chaleureux et authentiques pour vos vacances à la montagne.</p>
        <a href="/chalet" class="btn btn-alpine btn-lg px-4 fw-semibold shadow">Voir nos chalets</a>
    </div>
</section>
<section class="d-flex align-items-center justify-content-center text-center">
    <div class="container">
        <form action="/search" class="searchForm shadow-lg w-100 p-3 mb-5">
            <div class="row w-100 g-3 align-items-end">
                <div class="col-lg-4 col-md-4 col-sm-4 text-start">
                    <label class="form-label text-white fw-semibold mb-1" for="search">Rechercher</label>
                    <input class="form-control form-control-lg" type="search" name="search" id="search" placeholder="Où allez-vous ? (Station, Ville)">
                </div>
                <div class="col-lg-3 col-md-3 col-sm-3 text-start">
                    <label class="form-label text-white fw-semibold mb-1" for="date">Départ</label>
                    <input class="form-control form-control-lg" type="date" name="date" id="date" placeholder="Où allez-vous ? (Station, Ville)">
                </div>
                <div class="col-lg-3 col-md-3 col-sm-3 text-start">
                    <label class="form-label text-white fw-semibold mb-1" for="date2">Arrivée</label>
                    <input class="form-control form-control-lg" type="date" name="date" id="date" placeholder="Où allez-vous ? (Station, Ville)">
                </div>
                <div class="col-lg-2 col-md-2 col-sm-2 text-start">
                    <button class="btn btn-lg btn-alpine fw-semibold w-100" type="submit">Rechercher</button>
                </div>
            </div>
        </form>
    </div>
</section>
<section class="d-flex align-items-center justify-content-center recentChalet">
    <div class="container p-2">
        <div>
            <h2 class="fw-bold mb-3">Les derniers chalets récents</h2>
        </div>
        <div class="row w-100 justify-content-center">
            <% if (chalet && chalet.length > 0) { %>
                <% for (let i = 0; i < chalet.length; i++) { %>
                    <div class="col-lg-3">
                        <div class="card cardTransition">
                            <img class="card-img-top" src="" alt="">
                            <div class="card-body">
                                <h4 class="card-title"><%= chalet[i].title %></h4>
                                <p class="card-text">
                                    <%= chalet[i].description %>
                                </p>
                                <div class="d-flex justify-content-between align-items-center mt-3 pt-2 border-top">
                                    <span class="fw-bold text-alpine"><%= chalet[i].pricePerNight %> € / nuit</span>
                                    <a href="/chalet/<%= chalet[i]._id %>" class="btn btn-alpine btn-sm fw-semibold">Voir Chalet</a>
                                </div>
                            </div>
                        </div>
                    </div>
                <% } %>
            <% } else { %>
                <div class="col-12 text-center py-4 text-muted">
                    <p class="mb-0">Aucun chalet disponible pour le moment.</p>
                </div>
            <% } %>
        </div>
    </div>
</section>
<section class="d-flex align-items-center justify-content-center m-5">
    <div class="container">
        <div class="row w-100 justify-content-center d-flex">
            <div class="col-lg-4">
                <div class="card auth-card">
                    <div class="card-body text-center">
                        <h4 class="card-title">Emplacements d'exception</h4>
                        <p class="card-text">Des chalets idéalement situés au pied des pistes ou en pleine nature.</p>
                    </div>
                </div>
            </div>
            <div class="col-lg-4">
                <div class="card auth-card">
                    <div class="card-body text-center">
                        <h4 class="card-title">Réservation simple & rapide</h4>
                        <p class="card-text">Une interfarce fluide pour trouver et réserver votre séjour en quelques clics.</p>
                    </div>
                </div>
            </div>
            <div class="col-lg-4">
                <div class="card auth-card">
                    <div class="card-body text-center">
                        <h4 class="card-title">Chalets vérifié & confort</h4>
                        <p class="card-text">Une sélection rigoureuse de propriétés pour des prestations haut de gamme.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>