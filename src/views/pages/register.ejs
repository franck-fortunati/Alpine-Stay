<div class="row justify-content-center align-items-center flex-grow-1 auth-register ">
    <div class="col-sm-6 col-md-6 col-lg-4">
        <div class="card auth-card"> 
            <div class="card-body">
                <h2 class="card-title text-center mb-4">Inscription</h2>
                <form action="/register" method="post">
                    <div class="mb-4">
                        <label for="name" class="form-label">Nom d'utilisateur</label>
                        <input type="text" name="name" id="name" class="form-control" placeholder="Votre nom d'utilisateur..." required>
                    </div>
                    <div class="mb-4">
                        <label for="email" class="form-label">Email</label>
                        <input type="email" name="email" id="email" class="form-control" placeholder="Votre email..." required>
                    </div>
                    <div class="mb-4">
                        <label for="password" class="form-label">Mot de passe</label>
                        <input type="password" name="password" id="password" class="form-control" placeholder="Votre mot de passe..." required>
                    </div>
                    <div class="text-center">
                        <button type="submit" class="btn btn-outline-alpine w-50 fw-semibold">S'inscrire</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>