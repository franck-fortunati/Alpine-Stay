<section class="chaletForm d-flex align-items-center justify-content-center flex-grow-1">
    <div class="container d-flex justify-content-center">
        <form action="/chalet" method="POST" enctype="multipart/form-data" class="whiteForm shadow-lg w-75 p-3 mb-5">
            <div class="d-flex flex-column justify-content-center">
                <div class="row w-100">
                    <div class="col-lg-4">
                        <label class="form-label text-alpine fw-semibold mb-1" for="title">Nom du Chalet :</label>
                        <input class="form-control form-control-lg" type="text" name="title" id="title" placeholder="ex: Le Chalet des Cimes">
                    </div>
                    <div class="col-lg-4">
                        <label class="form-label text-alpine fw-semibold mb-1" for="title">Station de ski :</label>
                        <select class="form-select form-select-lg" type="text" name="station" id="station">
                            <option selected>Choisir la Station</option>
                            <% if (stations && stations.length > 0) { %>
                                <% stations.forEach(station => { %>
                                    <option value="<%= station._id %>">
                                        <%= station.name %> / <%= station.department %>
                                    </option>
                                <% }); %>
                            <% } %>
                        </select>
                    </div>
                    <div class="col-lg-4">
                        <label class="form-label text-alpine fw-semibold mb-1" for="pricePerNight">Prix par nuit (€) :</label>
                        <input class="form-control form-control-lg" type="number" name="pricePerNight" id="pricePerNight" placeholder="ex: 12">
                    </div>
                </div>
                <div class="d-flex row w-100 my-3">
                    <div class="col-lg-12">
                        <div class="form-check my-2">
                            <input class="form-check-input" name="piedDesPistes" type="checkbox" value="true" id="piedDesPistes">
                            <label class="form-check-label text-alpine fw-semibold mb-1" for="piedDesPistes">Chalet au pied des pistes</label>
                        </div>
                        <label class="form-label text-alpine fw-semibold mb-1" for="title">Description :</label>
                        <textarea class="form-control form-control-lg" id="description" name="description" rows="3"></textarea>
                    </div>
                </div>
                <div class="row w-100 d-flex align-items-end">
                    <div class="col-lg-6">
                        <label for="file" class="form-label text-alpine fw-semibold mb-1">Image :</label>
                        <input class="form-control form-control-lg" type="file" id="image" name="image">
                    </div>
                    <div class="col-lg-3">
                        <label class="form-label text-alpine fw-semibold mb-1" for="capacity">Nombre de personnes :</label>
                        <input class="form-control form-control-lg" type="number" name="capacity" id="capacity" placeholder="ex: 2">
                    </div>
                    <div class="col-lg-3">
                        <button class="btn btn-lg btn-outline-alpine w-100" type="submit">Envoyer</button>
                    </div>
                </div>
            </div>
        </form>
    </div>
</section>