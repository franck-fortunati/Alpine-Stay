<div class="row justify-content-center align-items-center flex-grow-1 auth-login ">
    <div class="col-sm-6 col-md-6 col-lg-4">
        <div class="card auth-card"> 
            <div class="card-body">
                <h2 class="card-title text-center mb-4">Connexion</h2>
                <form action="/login" method="post">
                    <div class="mb-4">
                        <label for="email" class="form-label">Email</label>
                        <input type="email" name="email" id="email" class="form-control" placeholder="Votre email..." required>
                    </div>
                    <div class="mb-4">
                        <label for="password" class="form-label">Mot de passe</label>
                        <input type="password" name="password" id="password" class="form-control" placeholder="Votre mot de passe..." required>
                    </div>
                    <div class="text-center">
                        <button type="submit" class="btn btn-outline-alpine w-50 fw-semibold">Connexion</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>