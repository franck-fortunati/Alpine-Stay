<!DOCTYPE html>
    <html lang="fr">
        <head>
            <meta charset="UTF-8">
            <meta name="viewport" content="width=device-width, initial-scale=1.0">
            <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
            <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
            <link rel="stylesheet" href="/css/style.css">
            <title><%= title %> | Dashboard Alpine Stay</title>
        </head>
        <body class="d-flex min-vh-100">
            <div class="sidebar min-vh-100 bg-alpine d-flex flex-column justify-content-between p-3 position-fixed">
                <div>
                    <div>
                        <a href="/" class="navbar-brand fw-bold text-white d-block text-center fs-5 mb-4">🏔️ Alpine <span class="text-secondary">Stay</span></a>
                    </div>
                    <div class="nav flex-column">
                        <a href="/admin" class="nav-link text-link fw-semibold d-flex align-items-center gap-2">
                            <i class="bi bi-grid-1x2-fill"></i> Dashboard
                        </a>
                        <a href="/admin/user" class="nav-link text-link fw-semibold d-flex align-items-center gap-2">
                            <i class="bi bi-people-fill"></i> Utilisateurs
                        </a>
                        <a href="/admin/chalet" class="nav-link text-link fw-semibold d-flex align-items-center gap-2">
                            <i class="bi bi-house-fill"></i> Chalets
                        </a>
                        <a href="/admin/reservation" class="nav-link text-link fw-semibold d-flex align-items-center gap-2">
                            <i class="bi bi-calendar2-week-fill"></i> Réservations
                        </a>
                        <a href="/admin/station" class="nav-link text-link fw-semibold d-flex align-items-center gap-2">
                            <i class="bi bi-tree-fill"></i> Stations
                        </a>
                    </div>
                </div>
                <div class="border-top border-secondary p-3">
                    <div>
                        <a href="/" class="nav-link text-link fw-semibold d-flex align-items-center gap-2">
                            <i class="bi bi-arrow-left-square-fill"></i> Retour à l'accueil
                        </a>
                    </div>
                </div>
            </div>
            <main class="dashboard flex-grow-1 d-flex flex-column">
                <%- include(page) %>
            </main>
            <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
        </body>
    </html>