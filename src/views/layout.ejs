<!DOCTYPE html>
    <html lang="fr">
        <head>
            <meta charset="UTF-8">
            <meta name="viewport" content="width=device-width, initial-scale=1.0">
            <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
            <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
            <link rel="stylesheet" href="/css/style.css">
            <title>
                <%= title %> | Alpine Stay
            </title>
        </head>
        <body class="d-flex flex-column min-vh-100">
            <header>
                <nav class="navbar navbar-expand-lg navbar-dark bg-alpine">
                    <div class="container">
                        <div class="row w-100 align-items-center m-0">
                            <div class="col-lg-4 col-8 p-0">
                                <a href="/" class="navbar-brand fw-bold text-white">🏔️ Alpine <span class="text-secondary">Stay</span></a>
                            </div>
                            <div class="col-4 d-lg-none text-end p-0">
                                 <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                                    <span class="navbar-toggler-icon"></span>
                                </button>
                            </div>
                            <div class="collapse navbar-collapse col-lg-8 p-0" id="navbarNav">
                                <div class="row w-100 align-items-center m-0">
                                    <!-- 2. Colonne Centre : Liens (col-lg-6 qui correspond à la zone du milieu) -->
                                    <div class="col-lg-6 text-center p-0 my-2 my-lg-0">
                                        <div class="navbar-nav justify-content-center">
                                            <a class="nav-link text-link text-nowrap fw-semibold" href="/">Accueil</a>
                                            <a class="nav-link text-link text-nowrap fw-semibold" href="/chalet">Nos Chalets</a>
                                            <a class="nav-link text-link text-nowrap fw-semibold" href="/chalet">Stations</a>
                                        </div>
                                    </div>
                                    <!-- 3. Colonne Droite : Boutons / Profil (col-lg-6) -->
                                    <% if (locals.user) { %>
                                        <div class="col-lg-6 d-flex justify-content-center justify-content-lg-end align-items-center gap-2 p-0">
                                            <a href="/chalet/new" class="btn btn-alpine btn-sm text-nowrap">Proposer un chalet</a>
                                            <div class="dropdown">
                                                <button class="btn btn-outline-none dropdown-toggle d-inline-flex align-items-center gap-2" type="button" id="userMenu" data-bs-toggle="dropdown" aria-expanded="false">
                                                    <i class="bi bi-person-circle fs-5 text-white"></i>
                                                    <span class="fw-semibold">Profil</span>
                                                </button>
                                                <ul class="dropdown-menu dropdown-menu-center shadow" aria-labelledby="userMenu">
                                                    <li><a class="dropdown-item text-drop fw-semibold" href="/profile">Mon Profil</a></li>
                                                    <li><a class="dropdown-item text-drop fw-semibold" href="/chalet/my-locations">Mes Locations</a></li>
                                                    <li><a class="dropdown-item text-drop fw-semibold" href="/reservation/my-reservation">Mes Réservations</a></li>
                                                    <% if (user.role === 'admin') { %>
                                                        <li><hr class="dropdown-divider"></li>
                                                        <li><a class="dropdown-item text-danger fw-semibold text-decoration-none" href="/admin">Administration</a></li>
                                                    <% } %>
                                                    <li><hr class="dropdown-divider"></li>
                                                    <li><a class="dropdown-item text-secondary fw-semibold text-decoration-none" href="/logout">Déconnexion</a></li>
                                                </ul>
                                            </div>
                                        </div>
                                    <% } else { %>
                                        <div class="col-lg-6 d-flex justify-content-center justify-content-lg-end align-items-center gap-2 p-0">
                                            <a href="/login" class="btn btn-alpine btn-sm">Connexion</a>
                                            <a href="/register" class="btn btn-alpine btn-sm fw-semibold">Inscription</a>
                                        </div>
                                    <% } %>
                                </div>
                             </div>
                        </div>
                    </div>
                </nav>
            </header>
            <main class="flex-grow-1 d-flex flex-column w-100">
                <%- include(page) %>
            </main>
            <footer class="bg-alpine text-white text-center py-3">
                <div class="container">
                    <p class="m-0">&copy; 2026 Alpine Stay — Tous droits réservés</p>
                </div>
            </footer>
            <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
        </body>
    </html>